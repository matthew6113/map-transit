{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Segments file (data/<era>/<group>/segments.geojson): physical rights-of-way",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "$comment": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?~?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD; a trailing ~ only when the source itself says circa."
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "supports"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "An id in data/sources.json."
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "geometry",
              "opened",
              "closed",
              "route",
              "fate",
              "status",
              "expected_opening",
              "operator",
              "gauge",
              "electrification",
              "photo",
              "name",
              "stations",
              "general"
            ]
          }
        },
        "pages": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "properties",
        "geometry"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "properties": {
          "$ref": "#/$defs/props"
        },
        "geometry": {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "enum": [
                "LineString",
                "MultiLineString"
              ]
            },
            "coordinates": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "system",
        "opened",
        "closed",
        "geometry_confidence",
        "geometry_method",
        "sources",
        "flags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "system": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "opened": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/date"
            }
          ]
        },
        "closed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/date"
            }
          ]
        },
        "structure": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "street",
                "surface",
                "elevated",
                "subway",
                "tunnel",
                "cut",
                "bridge",
                "trestle",
                "mole",
                "pier",
                "ferry"
              ]
            }
          ]
        },
        "shares_existing_track": {
          "type": "boolean",
          "description": "Future lines only: runs on track that already carries service."
        },
        "gauge_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "electrified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "from": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/date"
                  }
                ]
              },
              "to": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/date"
                  }
                ]
              }
            }
          }
        },
        "fate": {
          "enum": [
            "abandoned",
            "converted_to_bus",
            "absorbed_into_bart",
            "absorbed_into_muni",
            "rail_trail",
            "paved_over",
            "still_freight",
            "heritage_railway",
            "replaced_by_rail"
          ]
        },
        "successor_note": {
          "type": "string"
        },
        "geometry_confidence": {
          "enum": [
            "surveyed",
            "digitized",
            "approximate"
          ]
        },
        "geometry_method": {
          "type": "string",
          "minLength": 3
        },
        "georeference": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "opened_unsourced",
              "closed_unsourced",
              "expected_opening_unsourced",
              "status_unverified",
              "geometry_unverified",
              "needs_manual_digitizing",
              "conflicting_sources",
              "license_unclear"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
