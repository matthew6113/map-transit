{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source registry (data/sources.json) and systems (data/systems.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?~?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD; a trailing ~ only when the source itself says circa."
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "supports"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "An id in data/sources.json."
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "geometry",
              "opened",
              "closed",
              "route",
              "fate",
              "status",
              "expected_opening",
              "operator",
              "gauge",
              "electrification",
              "photo",
              "name",
              "stations",
              "general"
            ]
          }
        },
        "pages": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "author": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "enum": [
            "official",
            "primary_map",
            "primary_document",
            "book",
            "journal",
            "railfan_web",
            "wiki",
            "dataset"
          ]
        },
        "license": {
          "type": "string"
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
