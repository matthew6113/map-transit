{
  "name": "bay-area-transit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive map of Bay Area transit: everything that ever ran, everything running now, and what's coming.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test tests/interaction.spec.ts tests/editor.spec.ts",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "perf": "playwright test tests/perf.spec.ts"
  },
  "dependencies": {
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "preact": "11.0.0",
    "terra-draw": "1.35.0",
    "terra-draw-maplibre-gl-adapter": "1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
